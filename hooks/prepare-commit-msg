#!/usr/bin/env python3
"""prepare-commit-msg hook — auto-fills a Gemma-generated Conventional Commit.

Git runs this right before opening the commit message editor. We grab the
staged diff, ask the local Gemma model for a commit line, and pre-fill it.

Design rule: a commit must NEVER be blocked by this hook. Any problem
(tool missing, Ollama down, bad output) just exits 0 and leaves the message
untouched, so committing always works.
"""
import sys
import subprocess

# Git passes: argv[1] = path to the commit message file, argv[2] = source (optional)
msg_file = sys.argv[1]
source = sys.argv[2] if len(sys.argv) > 2 else ""

# Only auto-fill a normal commit. Skip when a message already exists:
#   "message" = -m/-F was used, "merge"/"squash" = generated, "commit" = amend/-c
if source in ("message", "merge", "squash", "commit"):
    sys.exit(0)

# Make the generator importable (path is filled in by install_hook.sh)
TOOL_DIR = "__TOOL_DIR__"
sys.path.insert(0, TOOL_DIR)
try:
    from generate_doc import build_prompt, call_gemma, extract_commit_line
except Exception:
    sys.exit(0)

# Grab the staged diff (hooks run from the repo root, so plain git works)
diff = subprocess.run(["git", "diff", "--cached"], capture_output=True, text=True).stdout
if not diff.strip():
    sys.exit(0)

# Ask Gemma — never let a failure block the commit
print("Contacting Gemma for a commit suggestion...", file=sys.stderr)
try:
    commit = extract_commit_line(call_gemma(build_prompt(diff)))
except Exception:
    sys.exit(0)

if not commit:
    sys.exit(0)

# Prepend the suggestion, keeping git's existing comments below it
with open(msg_file, "r", encoding="utf-8") as f:
    existing = f.read()
with open(msg_file, "w", encoding="utf-8") as f:
    f.write(
        commit
        + "\n\n# ^ AI-suggested commit message (Gemma). Edit or delete as you like.\n"
        + existing
    )
